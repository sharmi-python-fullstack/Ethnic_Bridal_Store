SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Required when DEBUG=False and served over HTTPS (e.g. on Render)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.onrender.com

# Database — leave blank to use SQLite.
# On Render this is set automatically from the PostgreSQL add-on.
DATABASE_URL=

# Razorpay credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email. For Gmail, turn on 2-Step Verification and use a 16-character Google
# App Password here—never the normal account password.
EMAIL_PROVIDER=smtp
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_DELIVERY_ENABLED=True
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-store-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=Shaaz Ethnicwear <your-store-email@gmail.com>
EMAIL_TIMEOUT=20
PASSWORD_RESET_TEST_MODE=False

# Render Free blocks SMTP. To use Brevo's HTTPS API instead, set
# EMAIL_PROVIDER=brevo and add the API key and a verified sender address.
# BREVO_API_KEY=your-brevo-api-key

# CORS origin for frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
